{% set active_page = "users" %}
{% set page_title = "Administrators" %}
{% extends "cms/base.html.j2" %}
{% block content %}
  <section>
    <header class="page-header">
      <div>
        <h1>Administrators</h1>
        <p>Manage team access to the CMS and article editor.</p>
      </div>
      <button class="button button--primary" type="button" data-dialog-open="user-create-dialog">
        <svg class="icon" aria-hidden="true"><use href="#icon-plus"></use></svg>
        Add
      </button>
    </header>

    <div class="panel">
      <header class="panel__header">
        <h2 class="panel__title">Team</h2>
        <span class="panel__caption">{{ users|length }} {% if users|length == 1 %}user{% else %}users{% endif %}</span>
      </header>
      <div class="table-scroll">
        <table aria-label="Administrator list">
          <colgroup><col style="width:75%"><col style="width:25%"></colgroup>
          <thead><tr><th>User</th><th style="text-align:right">Actions</th></tr></thead>
          <tbody>
            {% for u in users %}
            <tr>
              <td>
                <div class="user-cell">
                  <span class="user-avatar">{{ u.user_email[:2]|upper }}</span>
                  <span class="user-copy">
                    <strong>{{ u.user_email }}</strong>
                    <span>{% if u.user_email == request.session.get('user_email') %}You{% else %}CMS access{% endif %}</span>
                  </span>
                </div>
              </td>
              <td>
                <div class="actions">
                  <details class="action-menu">
                    <summary class="action-button" aria-label="More actions for {{ u.user_email }}">
                      <svg class="icon" aria-hidden="true"><use href="#icon-more"></use></svg>
                    </summary>
                    <div class="menu-popover">
                      <button class="menu-item" type="button" data-dialog-open="password-dialog-{{ loop.index }}">
                        <svg class="icon" aria-hidden="true"><use href="#icon-key"></use></svg>
                        Change password
                      </button>
                      <button
                        class="menu-item menu-item--danger"
                        type="button"
                        data-dialog-open="user-delete-dialog-{{ loop.index }}"
                        {% if u.user_email == request.session.get('user_email') %}disabled title="You cannot delete your own account"{% endif %}
                      >
                        <svg class="icon" aria-hidden="true"><use href="#icon-trash"></use></svg>
                        Remove administrator
                      </button>
                    </div>
                  </details>
                </div>
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <dialog
    class="dialog--small"
    id="user-create-dialog"
    aria-labelledby="user-create-dialog-title"
  >
    <header class="dialog__header">
      <div class="dialog__heading">
        <h2 id="user-create-dialog-title">Add administrator</h2>
      </div>
      <button class="icon-button" type="button" data-dialog-close aria-label="Close">
        <svg class="icon" aria-hidden="true"><use href="#icon-x"></use></svg>
      </button>
    </header>
    <form method="post" action="/cms/users/create" autocomplete="off">
      <div class="dialog__body">
        <div class="form-grid">
          <label class="field">
            <span class="field__label">Email</span>
            <input class="input" name="user_email" type="email" placeholder="name@company.com" required autocomplete="off" autofocus>
          </label>
          <label class="field">
            <span class="field__label">Temporary password</span>
            <input class="input" name="password" type="password" minlength="8" placeholder="At least 8 characters" required autocomplete="new-password">
          </label>
        </div>
      </div>
      <footer class="dialog__footer">
        <button class="button button--ghost" type="button" data-dialog-close>Cancel</button>
        <button class="button button--primary" type="submit">Add</button>
      </footer>
    </form>
  </dialog>

  {% for u in users %}
  <dialog
    class="dialog--small"
    id="password-dialog-{{ loop.index }}"
    aria-labelledby="password-dialog-{{ loop.index }}-title"
    aria-describedby="password-dialog-{{ loop.index }}-description"
  >
    <header class="dialog__header">
      <div class="dialog__heading">
        <h2 id="password-dialog-{{ loop.index }}-title">Change password</h2>
        <p class="dialog__description" id="password-dialog-{{ loop.index }}-description">{{ u.user_email }}</p>
      </div>
      <button class="icon-button" type="button" data-dialog-close aria-label="Close">
        <svg class="icon" aria-hidden="true"><use href="#icon-x"></use></svg>
      </button>
    </header>
    <form method="post" action="/cms/users/password">
      <input type="hidden" name="user_email" value="{{ u.user_email }}">
      <div class="dialog__body">
        <label class="field">
          <span class="field__label">New password</span>
          <input class="input" name="password" type="password" minlength="8" placeholder="At least 8 characters" required autocomplete="new-password" autofocus>
        </label>
      </div>
      <footer class="dialog__footer">
        <button class="button button--ghost" type="button" data-dialog-close>Cancel</button>
        <button class="button button--primary" type="submit">Update password</button>
      </footer>
    </form>
  </dialog>

  <dialog
    class="dialog--small dialog--danger"
    id="user-delete-dialog-{{ loop.index }}"
    aria-labelledby="user-delete-dialog-{{ loop.index }}-title"
    aria-describedby="user-delete-dialog-{{ loop.index }}-description"
  >
    <header class="dialog__header">
      <div class="dialog__heading">
        <h2 id="user-delete-dialog-{{ loop.index }}-title">Remove administrator?</h2>
        <p class="dialog__description" id="user-delete-dialog-{{ loop.index }}-description">{{ u.user_email }}</p>
      </div>
      <button class="icon-button" type="button" data-dialog-close aria-label="Close">
        <svg class="icon" aria-hidden="true"><use href="#icon-x"></use></svg>
      </button>
    </header>
    <form method="post" action="/cms/users/delete">
      <input type="hidden" name="user_email" value="{{ u.user_email }}">
      <div class="dialog__body">
        <div class="dialog__warning">
          <span class="dialog__warning-icon" aria-hidden="true">
            <svg class="icon"><use href="#icon-alert"></use></svg>
          </span>
          <span>
            <strong>Account will be removed</strong>
            <span>Existing CMS sessions remain active until they sign out or expire.</span>
          </span>
        </div>
      </div>
      <footer class="dialog__footer">
        <button class="button button--ghost" type="button" data-dialog-close autofocus>Cancel</button>
        <button class="button button--danger" type="submit" {% if u.user_email == request.session.get('user_email') %}disabled title="You cannot delete your own account"{% endif %}>Remove administrator</button>
      </footer>
    </form>
  </dialog>
  {% endfor %}
{% endblock %}
