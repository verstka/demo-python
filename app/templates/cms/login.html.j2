<!doctype html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="dark">
  <title>{% if bootstrap %}First administrator{% else %}Sign in{% endif %} — Verstka CMS</title>
  <link rel="icon" type="image/svg+xml" href="/cms/static/favicon.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&amp;display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/cms/static/cms-login.css?v=login-stats-cards-20260923">
</head>
<body>
  <main class="page-frame">
    <section class="auth-layout" data-testid="login-layout">
      <div class="auth-panel">
        <a class="brand" href="/cms/login">Verstka</a>
        <div class="auth-panel__content">
          <header class="auth-panel__header">
            <h1>{% if bootstrap %}Create your first administrator.{% else %}Welcome back.{% endif %}</h1>
            <p class="auth-lead">
              {% if bootstrap %}Set up the first account for this CMS workspace.{% else %}Enter your details to sign in to your workspace.{% endif %}
            </p>
          </header>

          <form class="auth-form" method="post" action="/cms/login" data-auth-form>
            {% if error %}<p class="auth-error" role="alert">{{ error }}</p>{% endif %}
            {% if bootstrap %}<p class="auth-hint">Only an Argon2 password hash will be stored. You will be signed in immediately.</p>{% endif %}
            <label class="field">
              <span class="field__label">Email</span>
              <input class="input" name="user_email" type="email" placeholder="name@company.com" required autocomplete="username">
            </label>
            <label class="field">
              <span class="field__label">Password</span>
              <input class="input" name="password" type="password" placeholder="Enter your password" required {% if bootstrap %}minlength="8" autocomplete="new-password"{% else %}autocomplete="current-password"{% endif %}>
            </label>
            <button class="submit" type="submit">
              <span class="submit__spinner" aria-hidden="true"></span>
              <span>{% if bootstrap %}Create administrator{% else %}Sign in{% endif %}</span>
            </button>
          </form>
        </div>
      </div>

      <aside class="auth-visual" aria-label="Publishing statistics">
        <section class="visual-stats" data-testid="login-stats">
          <header class="visual-stats__header">
            <h2>Get started with us</h2>
          </header>
          <dl class="stat-cards" aria-label="All-time publishing statistics">
            <div class="stat-card">
              <dt class="stat-card__label">Users signed in</dt>
              <dd class="stat-card__value" data-count-target="231">0</dd>
              <dd class="stat-card__note">active editorial users</dd>
            </div>
            <div class="stat-card">
              <dt class="stat-card__label">Articles created</dt>
              <dd class="stat-card__value" data-count-target="2147" data-count-format="comma">0</dd>
              <dd class="stat-card__note">drafts shaped into stories</dd>
            </div>
            <div class="stat-card">
              <dt class="stat-card__label">Journals connected</dt>
              <dd class="stat-card__value" data-count-target="37">0</dd>
              <dd class="stat-card__note">magazines and editorial brands</dd>
            </div>
          </dl>
        </section>
      </aside>
    </section>
  </main>
  <script src="/cms/static/cms.js?v=login-stats-duration-2000-20260923" defer></script>
</body>
</html>
