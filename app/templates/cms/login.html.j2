<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if bootstrap %}First administrator{% else %}Sign in{% endif %} — CMS</title>
  <style>
    body { font-family: system-ui, sans-serif; max-width: {% if bootstrap %}28rem{% else %}24rem{% endif %}; margin: 3rem auto; padding: 0 1rem; }
    label { display: block; margin-top: 1rem; }
    input { width: 100%; padding: 0.5rem; margin-top: 0.25rem; box-sizing: border-box; }
    button { margin-top: 1.5rem; padding: 0.5rem 1rem; }
    .err { color: #b00; margin-top: 1rem; }
    .hint { color: #444; font-size: 0.9rem; margin-top: 1.5rem; }
  </style>
</head>
<body>
  <h1>{% if bootstrap %}First administrator{% else %}CMS{% endif %}</h1>
  {% if bootstrap %}
  <p>No CMS users exist yet. Create the first administrator; only an argon2 password hash will be stored in SQLite.</p>
  {% endif %}
  {% if error %}<p class="err">{{ error }}</p>{% endif %}
  <form method="post" action="/cms/login">
    <label>Email <input name="user_email" {% if bootstrap %}type="email"{% endif %} required autocomplete="username"></label>
    <label>Password <input name="password" type="password" required {% if bootstrap %}minlength="8" autocomplete="new-password"{% else %}autocomplete="current-password"{% endif %}></label>
    {% if bootstrap %}<p class="hint">After creation, you will be signed in immediately.</p>{% endif %}
    <button type="submit">{% if bootstrap %}Create administrator{% else %}Sign in{% endif %}</button>
  </form>
</body>
</html>
