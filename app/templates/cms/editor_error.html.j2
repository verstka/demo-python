{% set active_page = "articles" %}
{% set page_title = "Editor error" %}
{% extends "cms/base.html.j2" %}
{% block title %}{{ title }} — Verstka CMS{% endblock %}
{% block content %}
  <section class="error-page" data-testid="editor-error-state">
    <div class="error-state">
      <span class="error-state__icon" aria-hidden="true">
        <svg class="icon"><use href="#icon-alert"></use></svg>
      </span>
      <p class="error-state__eyebrow">Editor connection</p>
      <h1>{{ title }}</h1>
      <p class="error-state__lead">The editor could not be opened for this request. Check the connection settings or return to your articles.</p>
      <a class="button button--primary" href="/cms/articles">Back to articles</a>

      <details class="error-details">
        <summary>Show technical details</summary>
        <div class="error-details__body">
          <p class="error-details__message">{{ message }}</p>
          <dl class="error-meta">
            <dt>API URL</dt>
            <dd><code>{{ api_url }}</code></dd>
            <dt>Callback URL</dt>
            <dd><code>{{ callback_url or "Not configured" }}</code></dd>
          </dl>
        </div>
      </details>
    </div>
  </section>
{% endblock %}
